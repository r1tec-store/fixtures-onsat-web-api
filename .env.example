# ---- server ----
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
# Public URL of this deployment (used in the OpenAPI "servers" entry)
PUBLIC_BASE_URL=
# Serve the built React app from the API process (single deploy)
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

# ---- data source (verified, see docs/REVERSE_ENGINEERING_REPORT.md) ----
SOURCE_BASE_URL=https://fixturessat.blogspot.com
SOURCE_USER_AGENT=fixtures-onsat-web-api/1.0
SOURCE_TIMEOUT_MS=15000
SOURCE_CONCURRENCY=4
# Pause before each upstream request (use ~400 on shared IPs such as CI runners)
SOURCE_DELAY_MS=0
# Live scores (best effort). Set ENABLE_SCORES=false to use kickoff-time estimates only.
ENABLE_SCORES=true
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer

# ---- sync & caching ----
SCHEDULE_REFRESH_MINUTES=10
CATALOG_REFRESH_MINUTES=180
DETAILS_TTL_MINUTES=30
LIVE_SCORES_TTL_SECONDS=30
IDLE_SCORES_TTL_SECONDS=300
MATCH_DURATION_MINUTES=120
# Last-known-good snapshot directory (mount a persistent disk here in production). Empty disables.
DATA_DIR=./data
DISABLE_SYNC=false

# ---- access control ----
# Comma-separated allowed browser origins; empty = any origin (public read-only API)
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
# Comma-separated API keys. Empty = open API. When set, send header X-API-Key.
API_KEYS=

# ---- frontend build (only when hosting the site separately, e.g. GitHub Pages) ----
# VITE_API_BASE_URL=https://your-api.onrender.com
